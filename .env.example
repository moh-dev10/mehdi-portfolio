# Supabase Configuration
# Required to enable Supabase database querying and contact message storage.
# The portfolio operates normally using local static fallback data when these are omitted.
# Obtain these values from your Supabase Dashboard: Project Settings -> API (or Data API)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
